            <!--     Text="Click me" -->
            <!--     SemanticProperties.Hint="Counts the number of times you click" -->
            <!--     Clicked="OnCounterClicked" -->
            <!--     HorizontalOptions="Fill" /> -->



            <Grid ColumnSpacing="2">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Label
                Text="Connection"
                Grid.ColumnSpan="2"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level2"
              />

              <Label
                Text="Hostname"
                Grid.Column="0"
                Grid.Row="1"
                VerticalTextAlignment="Center"
              />
              <Entry
                x:Name="ConnectionHostname"
                Placeholder="Hostname"
                TextChanged="OnConnectionEntryChanged"
                Grid.Column="1"
                Grid.Row="1"
              />

              <Label
                Text="Username"
                Grid.Column="0"
                Grid.Row="2"
                VerticalTextAlignment="Center"
              />
              <Entry
                x:Name="ConnectionUsername"
                Placeholder="Username"
                TextChanged="OnConnectionEntryChanged"
                Grid.Column="1"
                Grid.Row="2"
              />

              <Label
                Text="Password"
                Grid.Column="0"
                Grid.Row="3"
                VerticalTextAlignment="Center"
              />
              <Entry
                x:Name="ConnectionPassword"
                Placeholder="Password"
                TextChanged="OnConnectionEntryChanged"
                IsPassword="True"
                Grid.Column="1"
                Grid.Row="3"
              />
            </Grid>

            <HorizontalStackLayout>
              <Button
                  x:Name="ConnectBtn"
                  Text="Connect"
                  SemanticProperties.Hint="Try to connect using the credentials above"
                  Clicked="OnConnectClicked"
                  HorizontalOptions="Fill"
                />

              <Label
                x:Name="ConnectionStatusLabel"
                Margin="0, 0, 2, 0"
              />
              <Label
                x:Name="ConnectionMessageLabel"
              />

            </HorizontalStackLayout>

            <Label
              Text="Copy options"
              Style="{StaticResource Headline}"
              SemanticProperties.HeadingLevel="Level2"
            />
            <HorizontalStackLayout>
              <Label
                Text="Source"
                VerticalTextAlignment="Center"
                />
              <Picker x:Name="CopySourceMountPointPicker" />

              <Label
                Text="Destination"
                VerticalTextAlignment="Center"
              />
              <Picker x:Name="CopyDestinationLabelPicker" />
            </HorizontalStackLayout>
            <Button
              x:Name="CopyBtn"
              Text="Copy"
              SemanticProperties.Hint="Try to copy from the source to destination"
              Clicked="OnCopyClicked"
              HorizontalOptions="Fill"
            />

            <ScrollView>
              <Label x:Name="CopyOutput" />
            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
