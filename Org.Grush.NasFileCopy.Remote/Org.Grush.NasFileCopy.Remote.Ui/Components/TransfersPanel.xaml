<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Org.Grush.NasFileCopy.Remote.Ui.Components"
             xmlns:ssh="clr-namespace:Org.Grush.NasFileCopy.Remote.Share.Ssh;assembly=Org.Grush.NasFileCopy.Remote.Share"
             x:Class="Org.Grush.NasFileCopy.Remote.Ui.Components.TransfersPanel"
             x:DataType="components:TransfersPanel">

  <ListView ItemsSource="{ Binding Runs }">
    <ListView.ItemTemplate>
      <DataTemplate x:DataType="ssh:ExistingRun">
        <ViewCell>
          <components:TransferPanelRow
            Run="{ Binding . }"
          />
        </ViewCell>
      </DataTemplate>
    </ListView.ItemTemplate>
  </ListView>

</ContentView>