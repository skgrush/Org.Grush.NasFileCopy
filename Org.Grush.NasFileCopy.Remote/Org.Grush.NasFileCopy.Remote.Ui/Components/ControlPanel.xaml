<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:Org.Grush.NasFileCopy.Remote.Ui.Components"
             x:Class="Org.Grush.NasFileCopy.Remote.Ui.Components.ControlPanel"
             x:DataType="components:ControlPanel">
  <VerticalStackLayout>
    <Label>Source datasets</Label>
    <Picker
      x:Name="SourceDatasetPicker"
      SelectedIndexChanged="SourceDatasetPicker_OnSelectedIndexChanged"
      ItemsSource="{ Binding SourceDatasets }"
      ItemDisplayBinding="{ Binding Name }"
    />

    <BoxView HeightRequest="1" Color="White" />

    <Label>Destination devices</Label>
    <Picker
      x:Name="DestinationPicker"
      SelectedIndexChanged="DestinationPicker_OnSelectedIndexChanged"
      ItemsSource="{ Binding DestinationDevices }"
      ItemDisplayBinding="{ Binding Model }"
    />
    <Label>Optional destination path</Label>
    <Entry
      x:Name="DestinationPathEntry"
    />

    <Button
      x:Name="SubmitBtn"
      Clicked="SubmitBtn_OnClicked"
    />

  </VerticalStackLayout>
</ContentView>