<?xml version="1.0" encoding="utf-8"?>

<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:Class="Org.Grush.NasFileCopy.Remote.Ui.Components.ControlBar"
>
  <HorizontalStackLayout Spacing="10">
    <Button
      x:Name="ConnectBtn"
      Text="Connect"
      Clicked="ConnectBtn_OnClicked"
    />
    <Button
      x:Name="DisconnectBtn"
      Text="Disconnect"
      Clicked="DisconnectBtn_OnClicked"
    />
    <Button
      x:Name="ConfigBtn"
      Text="Configuration"
      Clicked="ConfigBtn_OnClicked"
    />
    <Button
      x:Name="RefreshBtn"
      Text="Refresh"
      Clicked="RefreshBtn_OnClicked"
    />
  </HorizontalStackLayout>
</ContentView>