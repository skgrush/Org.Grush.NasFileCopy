<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Org.Grush.NasFileCopy.Remote.Ui.Components.TransferInfoModal">
  <ContentPage.Content>
    <VerticalStackLayout>
      <TableView Intent="Data">
        <TableRoot>
          <TableSection x:Name="Table" />
        </TableRoot>
      </TableView>
      <HorizontalStackLayout>
        <Button Text="Close" x:Name="CloseBtn" Clicked="CloseBtn_OnClicked" />
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </ContentPage.Content>
</ContentPage>