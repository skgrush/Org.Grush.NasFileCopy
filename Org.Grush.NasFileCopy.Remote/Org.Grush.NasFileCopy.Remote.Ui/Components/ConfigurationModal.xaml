<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Org.Grush.NasFileCopy.Remote.Ui.Components.ConfigurationModal">
  <ContentPage.ToolbarItems>
    <ToolbarItem
      x:Name="BackToolbarBtn"
      Text="Back"
      Clicked="BackToolbarBtn_OnClicked"
    />
  </ContentPage.ToolbarItems>

  <ContentPage.Content>
    <Border>
      <VerticalStackLayout>
      <Label>Hostname</Label>
      <Entry />

      <Label>Username</Label>
      <Entry />

      <Label>SSH Private key path</Label>
      <Entry />
      </VerticalStackLayout>
    </Border>
  </ContentPage.Content>
</ContentPage>